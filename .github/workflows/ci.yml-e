name: CI

on:
  push:
    # claude/lucid-euler-0tjz9h is the default branch until it is renamed to main
    branches: [main, claude/lucid-euler-0tjz9h]
  pull_request:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

# The ruleset requires the checks `lint`, `python` and `native`. `python` and `native`
# are gate jobs over the parallel jobs below, so the work can be split without
# touching the ruleset.

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/ruff-action@v3
        with:
          args: check

  changes:
    # A pull request that only touches docs/ and top-level *.md skips the test jobs.
    # Pushes to the default branch always run everything.
    runs-on: ubuntu-latest
    outputs:
      code: ${{ steps.diff.outputs.code }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 2
      - id: diff
        run: |
          if [ "${{ github.event_name }}" != pull_request ]; then echo code=true >> "$GITHUB_OUTPUT"; exit 0; fi
          # HEAD is the PR merged into its base; HEAD^1 is the base.
          files=$(git diff --name-only HEAD^1 HEAD)
          echo "$files"
          if grep -qvE '^docs/|^[^/]+\.md$' <<< "$files"; then code=true; else code=false; fi
          echo "code=$code" >> "$GITHUB_OUTPUT"

  python-tests:
    # Reference engine only: rules, cards, bots, golden digests, RL on CPU torch.
    # Native variants skip here; native-tests runs them. Two shards (tests/conftest.py).
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        shard: [0, 1]
    env:
      OMP_NUM_THREADS: "1"  # one torch thread per xdist worker
      PYTEST_SHARD: ${{ matrix.shard }}/2
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
        with:
          python-version: "3.11"
          activate-environment: true
          enable-cache: true
<<<<<<< HEAD
      - run: uv pip install -e '.[dev,hosted]' numpy && uv pip install torch --index-url https://download.pytorch.org/whl/cpu
=======
      - run: uv pip install -e '.[dev]' numpy && uv pip install torch --index-url https://download.pytorch.org/whl/cpu
>>>>>>> origin/claude/lucid-euler-0tjz9h
      - name: Installed wheel data smoke
        if: matrix.shard == 0
        run: python tools/check_wheel.py
      - run: python -m pytest -q -n auto --durations=15 -m "not slow and not gpu"

  native-tests:
    # Rust engine: cargo tests, then the tests marked `native` (tests/conftest.py), in two shards.
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        shard: [0, 1]
    env:
      PYTEST_SHARD: ${{ matrix.shard }}/2
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: native
          save-if: ${{ matrix.shard == 0 }}
      - uses: astral-sh/setup-uv@v6
        with:
          python-version: "3.11"
          activate-environment: true
          enable-cache: true
      - run: uv pip install -e '.[dev]' "maturin>=1.5,<2"
      - if: matrix.shard == 0
        run: cargo test --no-default-features
        working-directory: native
      - run: maturin develop --release
        working-directory: native
      - run: python -m pytest -q -n auto --durations=15 -m "native and not slow and not gpu"   # torch tests skip here; python-tests covers them

  difftest:
    # 600 differential games as four parallel shards of 150.
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        matchup: [jund_blue, jund_madness]
        start: [0, 150]
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: native
          save-if: false  # native-tests (0) saves the cache
      - uses: astral-sh/setup-uv@v6
        with:
          python-version: "3.11"
          activate-environment: true
          enable-cache: true
      - run: uv pip install -e . "maturin>=1.5,<2"
      - run: maturin develop --release
        working-directory: native
      - run: python -m mtg_ml.difftest fuzz --games 150 --start ${{ matrix.start }} --jobs 4 --matchup ${{ matrix.matchup }}

  container:
    # Hosted play image (deploy/Dockerfile, docs/hosting.md): build and smoke test.
    # Informational: not part of the required `python`/`native` gates.
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - uses: docker/build-push-action@v6
        with:
          context: .
          file: deploy/Dockerfile
          load: true
          push: false
          tags: mtg-play:ci
          build-args: GIT_REV=${{ github.sha }}
          cache-from: type=gha,scope=mtg-play
          cache-to: type=gha,scope=mtg-play,mode=max
      - name: Smoke test
        run: |
          set -euxo pipefail
          test "$(docker run --rm mtg-play:ci id -u)" = 10001
          docker run --rm --read-only --tmpfs /tmp mtg-play:ci python -c "
          import mtg_ml_native, torch, numpy, starlette, uvicorn, jwt
          import mtg_ml.replay as r
          assert r.VIEWER.is_file() and (r.PLAY_APP / 'index.html').is_file(), r.ROOT
          assert not torch.cuda.is_available()
          print('imports ok; torch', torch.__version__)
          "
          docker run --rm --read-only --tmpfs /tmp mtg-play:ci python -m mtg_ml.hosted --help
          docker run --rm --read-only --tmpfs /tmp mtg-play:ci python -m mtg_ml.hosted check --help
      - name: Start-up smoke (dev user, no opponents)
        run: |
          set -euxo pipefail
          mkdir -p smoke/models smoke/state smoke/replays
          sudo chown -R 10001:10001 smoke/state smoke/replays
          printf 'player_decks = ["jund_wildfire"]\n' > smoke/play.toml
          docker run -d --name smoke --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges \
            -p 127.0.0.1:8080:8080 \
            -v "$PWD/smoke/models:/models:ro" -v "$PWD/smoke/state:/data/state" -v "$PWD/smoke/replays:/data/replays" \
            -v "$PWD/smoke/play.toml:/etc/play.toml:ro" -e MTG_HOSTED_PLAY_CONFIG=/etc/play.toml \
            -e MTG_HOSTED_INSECURE_DEV_USER=ci@example.com mtg-play:ci
          for i in $(seq 1 60); do
            if curl -fsS http://127.0.0.1:8080/healthz; then break; fi
            sleep 2
          done
          curl -fsS http://127.0.0.1:8080/healthz
          ls -la smoke/state smoke/replays
      - if: always()
        run: docker logs smoke || true

  python:
    needs: [changes, python-tests]
    if: always()
    runs-on: ubuntu-latest
    steps:
      - if: contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled')
        run: exit 1
      - run: echo ok

  native:
    needs: [changes, native-tests, difftest]
    if: always()
    runs-on: ubuntu-latest
    steps:
      - if: contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled')
        run: exit 1
      - run: echo ok
