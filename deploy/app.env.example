# /etc/mtg-play/app.env  (root:root 0600). Placeholders only: never commit real values.
# The image already sets MTG_ENGINE=native, MTG_HOSTED_HOST/PORT and the
# /models, /data/state, /data/replays paths; override only when needed.

# Cloudflare Access: team domain (JWT issuer) and the application audience tag.
MTG_ACCESS_TEAM_DOMAIN=https://<your-team>.cloudflareaccess.com
MTG_ACCESS_AUD=<access-application-audience-tag>

# Comma-separated allowlist (compared lower-cased). Keep in sync with the Access policy.
MTG_ALLOWED_EMAILS=alice@example.com,bob@example.com

# Public origin for the same-origin check on JSON mutations.
MTG_HOSTED_PUBLIC_ORIGIN=https://play.example.com

# Optional: GitHub issue filing (disabled unless 1).
# MTG_HOSTED_GITHUB_FILING=0

# Never set MTG_HOSTED_INSECURE_DEV_USER in production.
